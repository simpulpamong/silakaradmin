# Salin file ini menjadi `.env` lalu isi nilainya.
# Dimuat oleh vite.config.mts (loadEnv) dan api/server.ts.

# ── Menu Input Laporan (iframe penuh) ─────────────────────────
# Aplikasi pelaporan yang di-embed di halaman Input Laporan.
IFRAME_LAPOR_URL=https://laporsilakar.vercel.app

# ── API key (opsional) ────────────────────────────────────────
# Jika di-set, backend mewajibkan header `x-api-key` yang sama.
# Jika kosong, auth dilewati (mode dev/lokal).
API_KEY=

# Frontend mengirim `x-api-key` dari VITE_API_KEY (harus sama dengan API_KEY bila di-set).
VITE_API_KEY=

# ── Firebase ──────────────────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ── Cloudinary (upload foto) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google (Sheets / Drive / Docs) ────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Gunakan ID yang sama dengan SILAKAR. GOOGLE_SHEET_ID adalah nama canonical bersama.
# Wajib diisi untuk baca/tulis data. Saat belum diisi, UI tetap bisa berjalan.
GOOGLE_SHEET_ID=
# Folder utama Drive yang sama dengan SILAKAR.
GOOGLE_DRIVE_FOLDER_ID=

# ── Embed lainnya ─────────────────────────────────────────────
MYMAPS_VIEWER_URL=
MYMAPS_EMBED_URL=
